 void textblock_free(textblock *tb)
 {
+	size_t i;
+	for (i = 0; i < tb->span_count; ++i) {
+		string_free((char *)tb->spans[i].section);
+		string_free((char *)tb->spans[i].label);
+		string_free((char *)tb->spans[i].value);
+	}
+	mem_free(tb->spans);
 	mem_free(tb->text);
 	mem_free(tb->attrs);
 	mem_free(tb);
 }
 
+static void textblock_add_span(textblock *tb, const struct textblock_span *span)
+{
+	struct textblock_span copy = *span;
+	copy.section = string_make(span->section);
+	copy.label = span->label ? string_make(span->label) : NULL;
+	copy.value = span->value ? string_make(span->value) : NULL;
+	tb->spans = mem_realloc(tb->spans,
+		(tb->span_count + 1) * sizeof(*tb->spans));
+	tb->spans[tb->span_count++] = copy;
+}
+
+void textblock_end_section(textblock *tb, const char *section)
+{
+	struct textblock_span span = { section, NULL, NULL, tb->section_start,
+		tb->strlen - tb->section_start, 0 };
+	textblock_add_span(tb, &span);
+	tb->section_start = tb->strlen;
+}
+
+void textblock_append_field(textblock *tb, const char *section,
+	const char *label, const char *value, uint8_t attr)
+{
+	struct textblock_span span = { section, label, value, tb->strlen, 0, attr };
+	textblock_append_c(tb, attr, "%s%s%s\n", label ? label : "",
+		label ? ": " : "", value ? value : "");
+	span.length = tb->strlen - span.start;
+	textblock_add_span(tb, &span);
+	tb->section_start = tb->strlen;
+}
+
+const struct textblock_span *textblock_spans(const textblock *tb, size_t *count)
+{
+	*count = tb->span_count;
+	return tb->spans;
+}
+
