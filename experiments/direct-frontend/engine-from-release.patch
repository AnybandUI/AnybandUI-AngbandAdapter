+#include "cave.h"
+#include "grafmode.h"
+#include "init.h"
+#include "mon-predicate.h"
+#include "mon-util.h"
+#include "monster.h"
+#include "obj-tval.h"
+#include "obj-util.h"
+#include "player-timed.h"
+#include "trap.h"
