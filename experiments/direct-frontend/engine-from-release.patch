+	struct textblock_span span = { section, label, value, tb->strlen, 0, attr };
+	textblock_append_c(tb, attr, "%s%s%s\n", label ? label : "",
+		label ? ": " : "", value ? value : "");
+	span.length = tb->strlen - span.start;
+	textblock_add_span(tb, &span);
+	tb->section_start = tb->strlen;
+}
+
+const struct textblock_span *textblock_spans(const textblock *tb, size_t *count)
+{
+	*count = tb->span_count;
