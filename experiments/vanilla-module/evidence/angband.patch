diff --git a/src/frontend-exports.cmake b/src/frontend-exports.cmake
new file mode 100644
index 000000000..a7e67b3a8
--- /dev/null
+++ b/src/frontend-exports.cmake
@@ -0,0 +1,20 @@
+# Include public constant and tentative data omitted by CMake's auto exports.
+execute_process(COMMAND "${TOOLS}/dumpbin.exe" /symbols "@${ROOT}/frontend-objects.rsp"
+    OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
+if(NOT result STREQUAL "0")
+    message(FATAL_ERROR "Could not collect frontend data exports: ${result}")
+endif()
+string(REGEX MATCHALL "[0-9A-F]+ +[0-9A-F]+ +(UNDEF|SECT[0-9A-F]+) +notype +External[^\r\n]*" entries "${symbols}")
+set(exports "EXPORTS\n")
+foreach(entry IN LISTS entries)
+    if(entry MATCHES "^[0-9A-F]+ +([0-9A-F]+) +(UNDEF|SECT[0-9A-F]+).*\\| ([A-Za-z_][A-Za-z_0-9]*)$")
+        set(name "${CMAKE_MATCH_3}")
+        if(NOT CMAKE_MATCH_2 STREQUAL "UNDEF" OR NOT CMAKE_MATCH_1 STREQUAL "00000000")
+            if(BITS EQUAL 4)
+                string(SUBSTRING "${name}" 1 -1 name)
+            endif()
+            string(APPEND exports "${name} DATA\n")
+        endif()
+    endif()
+endforeach()
+file(WRITE "${ROOT}/frontend-data.def" "${exports}")
diff --git a/src/frontend-module.c b/src/frontend-module.c
new file mode 100644
index 000000000..c60ec2ded
--- /dev/null
+++ b/src/frontend-module.c
@@ -0,0 +1,70 @@
+/** \file frontend-module.c
+ * \brief Load an explicitly selected, build-matched Windows frontend.
+ *
+ * Released under the same licences as Angband.
+ */
+#include "frontend-module.h"
+#include "frontend-build.h"
+#include <windows.h>
+#include <shellapi.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int frontend_module_start(int *status)
+{
+	typedef const struct frontend_module *(*query_fn)(void);
+	int argc, i;
+	wchar_t **wide = CommandLineToArgvW(GetCommandLineW(), &argc);
+	wchar_t path[MAX_PATH];
+	char **argv = NULL;
+	HMODULE library = NULL;
+	query_fn query;
+	const struct frontend_module *module;
+	DWORD length;
+
+	*status = 2;
+	if (!wide) return 1;
+	if (argc < 2 || wcscmp(wide[1], L"--frontend")) {
+		LocalFree(wide);
+		return 0;
+	}
+	if (argc < 3) goto failed;
+	length = GetFullPathNameW(wide[2], MAX_PATH, path, NULL);
+	if (!length || length >= MAX_PATH) goto failed;
+	library = LoadLibraryExW(path, NULL,
+		LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+	if (!library) goto failed;
+	query = (query_fn)GetProcAddress(library, "angband_frontend_v1");
+	module = query ? query() : NULL;
+	if (!module || !module->build_id || !module->run ||
+		strcmp(module->build_id, ANGBAND_FRONTEND_BUILD_ID)) {
+		fputs("The frontend does not match this Angband build.\n", stderr);
+		goto done;
+	}
+	argv = calloc((size_t)argc - 1, sizeof(*argv));
+	if (!argv) goto failed;
+	for (i = 2; i < argc; ++i) {
+		int n = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS,
+			wide[i], -1, NULL, 0, NULL, NULL);
+		argv[i - 2] = n ? malloc((size_t)n) : NULL;
+		if (!argv[i - 2] || !WideCharToMultiByte(CP_UTF8,
+			WC_ERR_INVALID_CHARS, wide[i], -1, argv[i - 2], n,
+			NULL, NULL)) goto failed;
+	}
+	*status = module->run(argc - 2, argv);
+	/* Engine callbacks may still reference the module until process exit. */
+	library = NULL;
+	goto done;
+
+failed:
+	fputs("Could not start the selected frontend.\n", stderr);
+done:
+	if (argv) {
+		for (i = 0; i < argc - 2; ++i) free(argv[i]);
+		free(argv);
+	}
+	if (library) FreeLibrary(library);
+	LocalFree(wide);
+	return 1;
+}
