--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -439,6 +439,48 @@ target_include_directories(OurExecutable PRIVATE
 )
 target_link_libraries(OurExecutable PRIVATE ${ANGBAND_CORE_LINK_LIBRARIES})
 
+# Native modules use the exact engine build's existing C interfaces.
+if(SUPPORT_WINDOWS_FRONTEND AND MSVC)
+    option(SUPPORT_FRONTEND_MODULES "Load build-matched native frontends" ON)
+    if(SUPPORT_FRONTEND_MODULES)
+        target_sources(OurExecutable PRIVATE src/frontend-module.c)
+        target_compile_definitions(OurExecutable PRIVATE FRONTEND_MODULES)
+        target_include_directories(OurExecutable PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
+        set_target_properties(OurExecutable PROPERTIES
+            ENABLE_EXPORTS ON WINDOWS_EXPORT_ALL_SYMBOLS ON)
+        # CMake's automatic exports omit some public constant and tentative data.
+        get_filename_component(FRONTEND_TOOLS "${CMAKE_LINKER}" DIRECTORY)
+        file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/frontend-objects.rsp"
+            CONTENT "\"$<JOIN:$<TARGET_OBJECTS:OurCoreLib>,\"\n\">\"\n")
+        add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/frontend-data.def"
+            COMMAND "${CMAKE_COMMAND}" "-DTOOLS=${FRONTEND_TOOLS}"
+                "-DROOT=${CMAKE_CURRENT_BINARY_DIR}" "-DBITS=${CMAKE_SIZEOF_VOID_P}"
+                -P "${CMAKE_CURRENT_SOURCE_DIR}/src/frontend-exports.cmake"
+            DEPENDS $<TARGET_OBJECTS:OurCoreLib> src/frontend-exports.cmake VERBATIM)
+        target_sources(OurExecutable PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/frontend-data.def")
+        file(GLOB_RECURSE FRONTEND_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/src/*.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/src/*.h"
+            "${CMAKE_CURRENT_SOURCE_DIR}/src/frontend-exports.cmake")
+        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${FRONTEND_SOURCES})
+        set(FRONTEND_ID "")
+        foreach(setting CMAKE_C_COMPILER_ID CMAKE_C_COMPILER_VERSION
+                CMAKE_SIZEOF_VOID_P CMAKE_BUILD_TYPE CMAKE_C_FLAGS
+                CMAKE_C_FLAGS_DEBUG CMAKE_C_FLAGS_RELEASE
+                CMAKE_C_FLAGS_RELWITHDEBINFO CMAKE_C_FLAGS_MINSIZEREL
+                CMAKE_MSVC_RUNTIME_LIBRARY SUPPORT_BORG SUPPORT_BORG_HIGH_SCORES)
+            string(APPEND FRONTEND_ID "${setting}=${${setting}};")
+        endforeach()
+        foreach(source IN LISTS FRONTEND_SOURCES)
+            file(SHA256 "${source}" digest)
+            string(APPEND FRONTEND_ID "${digest}")
+        endforeach()
+        file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt" digest)
+        string(SHA256 FRONTEND_ID "${FRONTEND_ID};${digest}")
+        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/frontend-build.h"
+            "#define ANGBAND_FRONTEND_BUILD_ID \"${FRONTEND_ID}\"\n")
