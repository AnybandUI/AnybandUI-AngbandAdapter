+	                               "Combat", "Skills"};
+	size_t i, j;
+	for (i = 0; i < N_ELEMENTS(panels); ++i) {
+		struct panel *p = panels[i].panel();
+		for (j = 0; j < p->len; ++j) {
+			const struct panel_line *line = &p->lines[j];
+			if (line->label)
+				emit(user, groups[i], line->label,
+				     (i == 0 && j == 0) ? player->full_name : line->value,
+				     line->attr);
+		}
+		panel_free(p);
+	}
+}
